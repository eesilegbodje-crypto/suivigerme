# Copiez ce fichier en ".env.local" si vous voulez surcharger l'adresse du serveur en local
# (par défaut, sans ce fichier, l'application utilise http://localhost:4100).
# Une fois en ligne, cette variable sera définie directement sur l'hébergeur avec la vraie
# adresse du serveur (ex. https://suivigerme-api.onrender.com).
VITE_API_URL=http://localhost:4100
